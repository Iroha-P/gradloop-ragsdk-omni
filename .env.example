# Runtime profile: local_baseline | test_fake | ragsdk_local | ragsdk_full
BAOYAN_PROFILE=local_baseline

# Backend selection is explicit. A failed ragsdk backend never falls back silently.
BAOYAN_RAG_BACKEND=baseline
BAOYAN_LLM_BACKEND=none
BAOYAN_MULTIMODAL_BACKEND=none
BAOYAN_AGENT_ENGINE=langgraph
BAOYAN_AGENT_CHECKPOINT_PATH=data/local/app/agent_checkpoints.sqlite
BAOYAN_LLAMACPP_BASE_URL=http://127.0.0.1:11435
BAOYAN_LLAMACPP_MODEL=qwen3-4b-q4
BAOYAN_LLAMACPP_TIMEOUT_SECONDS=180
BAOYAN_LLAMACPP_CONTEXT_CHARS=12000
BAOYAN_LLAMACPP_TEMPERATURE=0.7
BAOYAN_MINICPMO_BASE_URL=http://127.0.0.1:18080
BAOYAN_MINICPMO_MODEL=openbmb/MiniCPM-o-4_5
BAOYAN_MINICPMO_ALLOWED_HOSTS=127.0.0.1,localhost,::1
BAOYAN_MINICPMO_TIMEOUT_SECONDS=180
BAOYAN_MINICPMO_MAX_UPLOAD_BYTES=8388608
BAOYAN_MINICPMO_MAX_ATTACHMENTS=4
BAOYAN_MINICPMO_MAX_TOKENS=512
# Set only in the process environment when the remote service requires authentication.
BAOYAN_MINICPMO_API_TOKEN=
BAOYAN_TOP_K=5
BAOYAN_MAX_QUERY_CHARS=4096
BAOYAN_MAX_EXPENSIVE_REQUESTS=2
BAOYAN_CAPACITY_RETRY_AFTER_SECONDS=1
BAOYAN_LOG_LEVEL=INFO
BAOYAN_DATABASE_PATH=data/local/app/learning.db
BAOYAN_CORPUS_PATH=data/local/private/indexes/baseline/corpus.jsonl
BAOYAN_FEISHU_SPACE_ID=
BAOYAN_FEISHU_SPACE_NAME=
BAOYAN_FEISHU_SNAPSHOT_PATH=data/local/feishu/current
BAOYAN_QUESTION_BANK_PATH=data/local/question_bank/questions.jsonl
BAOYAN_COVERAGE_PATH=data/local/question_bank/coverage.json
BAOYAN_GENERIC_CORPUS_PATH=data/local/question_bank/corpora/generic.jsonl
BAOYAN_PERSONAL_CORPUS_PATH=data/local/question_bank/corpora/personal.jsonl

# RAGSDK services are only used by ragsdk profiles. These are placeholders.
BAOYAN_RAGSDK_DATA_ROOT=data/local/ragsdk
BAOYAN_RAGSDK_MILVUS_URI=data/local/ragsdk/milvus.db
BAOYAN_RAGSDK_EMBEDDING_URL=http://127.0.0.1:8080/v1/embeddings
BAOYAN_RAGSDK_EMBEDDING_DIMENSION=1024
BAOYAN_RAGSDK_RETRIEVAL_MODE=dense
BAOYAN_RAGSDK_RERANKER_URL=http://127.0.0.1:8081/v1/rerank
BAOYAN_RAGSDK_DENSE_CANDIDATE_K=20
BAOYAN_RAGSDK_SPARSE_CANDIDATE_K=20
BAOYAN_RAGSDK_FUSION_CANDIDATE_K=20
BAOYAN_RAGSDK_FUSION_BASELINE=0.4
BAOYAN_RAGSDK_FUSION_AMPLITUDE=0.3
BAOYAN_RAGSDK_FUSION_SLOPE=1.0
BAOYAN_RAGSDK_FUSION_MIDPOINT=6.0
BAOYAN_RAGSDK_KNOWLEDGE_NAME=baoyan_private
BAOYAN_RAGSDK_USER_ID=local_user
BAOYAN_RAGSDK_VECTOR_COLLECTION=baoyan_vectors
BAOYAN_RAGSDK_CHUNK_COLLECTION=baoyan_chunks
BAOYAN_RAGSDK_TIMEOUT_SECONDS=60
BAOYAN_RAGSDK_SCORE_THRESHOLD=
BAOYAN_RAGSDK_LLM_URL=http://127.0.0.1:1025/v1/chat/completions
BAOYAN_RAGSDK_LLM_MODEL=replace-with-model-name

# Public browser settings only; the MAP API key belongs in the proxy secret store.
GRADLOOP_MAP_REALTIME_ENABLED=false
GRADLOOP_MAP_PROXY_URL=wss://replace-with-worker.example/ws
GRADLOOP_MAP_SESSION_SECONDS=300

# Never put real keys or private paths in this file.
LLM_API_KEY=
